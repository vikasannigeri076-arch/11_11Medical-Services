<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgcolor">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bgcolor"
        app:elevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@android:drawable/ic_menu_revert">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Profile"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/PrimaryTextColor"/>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Shop Photo Placeholder -->
            <ImageView
                android:id="@+id/ivShopPhoto"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_myplaces"
                android:background="@drawable/circle_bg"
                android:padding="20dp"
                android:layout_marginBottom="20dp"
                app:tint="@color/PrimaryTextColor" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop Name"
                android:textSize="14sp"
                android:textColor="@color/loginsignuptxtcolor"/>
            <EditText
                android:id="@+id/etProfileShopName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rect_border_black"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owner Name"
                android:textSize="14sp"
                android:textColor="@color/loginsignuptxtcolor"/>
            <EditText
                android:id="@+id/etProfileOwnerName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rect_border_black"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phone Number"
                android:textSize="14sp"
                android:textColor="@color/loginsignuptxtcolor"/>
            <EditText
                android:id="@+id/etProfileShopPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:enabled="false"
                android:background="@drawable/rect_border_black"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GST Number"
                android:textSize="14sp"
                android:textColor="@color/loginsignuptxtcolor"/>
            <EditText
                android:id="@+id/etProfileGST"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/rect_border_black"
                android:padding="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Address"
                android:textSize="14sp"
                android:textColor="@color/loginsignuptxtcolor"/>
            <EditText
                android:id="@+id/etProfileShopAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="70dp"
                android:background="@drawable/rect_border_black"
                android:padding="10dp"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnUpdateShopProfile"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Update Shop Profile"
                android:backgroundTint="@color/signupbtn"
                android:layout_marginBottom="40dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>